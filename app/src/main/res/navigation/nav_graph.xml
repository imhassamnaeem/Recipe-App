<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splash">


    <fragment
        android:id="@+id/splash"
        android:name="com.example.recipeapp.presentation.splash.Splash"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splash_to_onBoarding"
            app:destination="@id/onBoarding" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/home" />
    </fragment>
    <fragment
        android:id="@+id/onBoarding"
        android:name="com.example.recipeapp.presentation.onboarding.OnBoarding"
        android:label="fragment_on_boarding"
        tools:layout="@layout/fragment_on_boarding" />
    <fragment
        android:id="@+id/home"
        android:name="com.example.recipeapp.presentation.home.Home"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />
</navigation>